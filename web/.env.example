# ProphETF environment. Copy to .env.local (git-ignored) and fill in. Never commit real values.
# In production these live in Vercel > Project > Settings > Environment Variables.

# --- Core ---
# Tiger Cloud (Postgres + TimescaleDB + pgvector). Direct connection string, sslmode=require.
DATABASE_URL=
# Google Gemini API key (AI Studio). No Google Cloud project needed.
GEMINI_API_KEY=
# Shared secret for /api/jobs/* (Authorization: Bearer <CRON_SECRET>). Any long random string.
CRON_SECRET=
# Public base URL of the app, no trailing slash (http://localhost:3000 locally).
APP_BASE_URL=http://localhost:3000

# --- Decision workflow (analyst -> gate -> decider -> checker) ---
# Who writes the evidence packet: mock (built-in) | module (src/lib/analyst/index.ts) | tiger (tables of migration 0007).
ANALYST_MODE=mock
# "true" adds an LLM review to the checker: one more Gemini call per uncached request.
CHECKER_LLM=false
# A model id to try first for decisions. Leave empty: the chain in src/lib/gemini/models.ts starts with
# gemini-3.5-flash-lite. The models, their limits and the fallback order all live in that file.
DECIDER_MODEL=

# --- Feature flags: "true" turns the live integration on; anything else uses the mock ---
# Snowflake was dropped; keep this false. Nothing reads it.
FEATURE_SNOWFLAKE=false
FEATURE_ELEVENLABS=false
FEATURE_SOLANA=false
FEATURE_PRESAGE=false
FEATURE_WS=false

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Solana (devnet only) ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_ATTESTER_SECRET_KEY=
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# --- Presage ---
PRESAGE_API_KEY=
# mock | sidecar | api
PRESAGE_MODE=mock
PRESAGE_SIDECAR_URL=

# --- Optional ---
# Extra allowed CORS origins for the public API, comma-separated (e.g. a custom domain).
CORS_ORIGINS=
