{
  "name": "prophetf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:status": "tsx --env-file-if-exists=.env.local scripts/migrate.ts --status",
    "sync:universe": "node scripts/sync-universe.mjs",
    "try:findstocks": "tsx --env-file-if-exists=.env.local scripts/try-findstocks.mts",
    "parity:weights": "node scripts/run-parity.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.10.1"
}
