{
  "name": "prophetf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/sync-agent.mjs && node scripts/sync-lab.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:status": "tsx --env-file-if-exists=.env.local scripts/migrate.ts --status",
    "sync:universe": "node scripts/sync-universe.mjs",
    "sync:agent": "node scripts/sync-agent.mjs",
    "sync:lab": "node scripts/sync-lab.mjs",
    "try:clarify": "tsx --env-file-if-exists=.env.local scripts/try-clarify.mts",
    "try:findstocks": "tsx --env-file-if-exists=.env.local scripts/try-findstocks.mts",
    "parity:weights": "node scripts/run-parity.mjs",
    "jobs:loop": "tsx --env-file-if-exists=.env.local scripts/jobs-loop.mts",
    "try:odds": "tsx --env-file-if-exists=.env.local scripts/try-odds.mts",
    "closes:load": "tsx --env-file-if-exists=.env.local scripts/load-closes.mts",
    "track:leak-check": "tsx --env-file-if-exists=.env.local scripts/leak-check.mts",
    "track:replay": "tsx --env-file-if-exists=.env.local scripts/replay-panel.mts",
    "track:daily": "tsx --env-file-if-exists=.env.local scripts/track-daily.mts",
    "demo:warm": "tsx --env-file-if-exists=.env.local scripts/demo-warm.mts",
    "try:letter": "tsx --env-file-if-exists=.env.local scripts/try-letter.mts",
    "try:narrate": "tsx --env-file-if-exists=.env.local scripts/try-narrate.mts",
    "eval:decider": "tsx --env-file-if-exists=.env.local scripts/eval-decider.mts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.10.1"
}
