{
  "version": 1,
  "project": "MyETF (ProphETF) turns a person's idea into a basket of three stocks. This agent only chooses the three stocks. A separate service then sets the weights from Polymarket odds, and the website shows the basket.",
  "outputRules": [
    "Return exactly 3 stocks with unique symbols.",
    "Every symbol must come from the allowed list; the weighting service can only tilt these 40.",
    "Use the name exactly as written in the allowed list.",
    "The summary is at most 12 words, plain language, no numbers and no promises about returns.",
    "Return only the summary and the three symbols: no reasons, no research, no market data.",
    "Prefer companies. Choose a fund (kind \"fund\") only when the idea is about bonds, interest rates or the bitcoin price itself.",
    "Respect the preferences saved for this session, and avoid repeating the previous basket for the same idea unless the person asks for it."
  ],
  "context": [
    {
      "id": "flow",
      "keywords": [],
      "text": "Flow: idea → this agent picks 3 stocks → equal starting weights (33.33, 33.33, 33.34) → the weighting service tilts them by how prediction-market odds moved."
    },
    {
      "id": "fit",
      "keywords": [],
      "text": "Pick the three stocks whose business is most directly affected by the idea. When an idea spans two sectors, cover both."
    },
    {
      "id": "unsupported",
      "keywords": [],
      "text": "If the idea matches no sector (for example sports or cooking), pick the three closest large companies from the allowed list rather than refusing."
    },
    {
      "id": "markets",
      "keywords": [
        "taiwan",
        "fed",
        "recession",
        "hormuz",
        "iran",
        "ukraine",
        "bitcoin",
        "export",
        "openai",
        "ai safety"
      ],
      "text": "The weighting service tracks these prediction markets: China invades Taiwan; No Fed rate cuts in 2026; US recession by end of 2026; Strait of Hormuz traffic normalizes; Bab el-Mandeb Strait closed; US-Iran final nuclear deal; Russia-Ukraine ceasefire agreement; Bitcoin reaches $100k in 2026; AI-chip export licensing becomes law; OpenAI IPOs above $1T; US enacts AI safety bill. Stocks tied to them get the most meaningful weights."
    },
    {
      "id": "language",
      "keywords": [],
      "text": "Ideas may arrive in any language. Write the summary in the language of the idea."
    }
  ],
