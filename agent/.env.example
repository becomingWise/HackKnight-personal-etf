# Copy to agent/.env and enter the key locally. Do not commit the completed .env.
GEMINI_API_KEY=
# The agent itself always runs on the Flash-Lite models (500 free requests a day each):
# gemini-3.5-flash-lite, then gemini-3.1-flash-lite. A Flash-Lite model named here is tried first.
# Any other model named here is used ONLY for the Google Search tool, e.g. gemini-3.8-flash
# (the free tier has no Google Search quota on Flash-Lite, and Flash has 20 requests a day).
GEMINI_MODEL=gemini-3.5-flash-lite
# Each local session has separate preferences and basket memory.
MYETF_SESSION_ID=local
